APP_NAME="GreenCart POS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://YOUR_SERVER_IP

LOG_CHANNEL=stack
LOG_LEVEL=error
DEBUGBAR_ENABLED=false

# "db" is the MySQL service name in docker-compose.prod.yml
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=greencart_pos
DB_USERNAME=greencart
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME_TOO

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Linux PDF binary (installed by composer)
WKHTML_PDF_BINARY=/var/www/html/vendor/h4cc/wkhtmltopdf-amd64/bin/wkhtmltopdf-amd64
